    { "id": "prompt_to_model", "from": "compose_prompt", "to": "generate_bundle", "label": "one request", "variant": "emphasis", "role": "main" },
    { "id": "model_to_bundle", "from": "generate_bundle", "to": "typed_bundle", "label": "structured JSON", "role": "main" },
