    { "id": "correct_bundle", "lane": "generation", "col": 5, "type": "backend", "label": "Repair or Revise", "sublabel": "only when required", "width": 146 },
    { "id": "build_metrics", "lane": "quality", "col": 5, "type": "backend", "label": "RTM & Metrics", "sublabel": "deterministic", "width": 136 },
